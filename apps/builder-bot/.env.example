# ===== REQUIRED =====
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=YourBotName

# ===== DATABASE =====
DATABASE_URL=postgresql://user:password@localhost:5432/ton_agent_platform
DB_HOST=localhost
DB_PORT=5432
DB_USER=ton_agent
DB_PASSWORD=changeme
DB_NAME=ton_agent_platform
DB_SSL=false

# ===== AI PROVIDERS (at least one required) =====
# Platform default AI (used when user has no personal key)
# Supports: Gemini (default), OpenAI, Anthropic, Groq, DeepSeek, OpenRouter, Together
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=your_api_key_here

# Model overrides (optional — sensible defaults are used per provider)
# CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=4000
# AI_MODEL=gemini-2.5-flash

# Platform proxy fallback (used if user has no API key configured)
# PLATFORM_AI_URL=https://api.openai.com/v1
# PLATFORM_AI_KEY=sk-...
# PLATFORM_AI_MODEL=gpt-4o-mini

# ===== ENCRYPTION =====
# Required for wallet mnemonic encryption (AES-256-GCM, 32-byte key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_key_here

# ===== SECURITY =====
SESSION_TIMEOUT_MINUTES=30
MAX_EXECUTION_TIME_MS=30000
ENABLE_SECURITY_SCAN=true

# ===== TON BLOCKCHAIN =====
TONAPI_KEY=your_tonapi_key_here
PLATFORM_WALLET_ADDRESS=your_ton_wallet_address

# ===== OWNER =====
OWNER_ID=your_telegram_user_id

# ===== PUBLIC URL =====
LANDING_URL=https://tonagentplatform.com

# ===== SERVER =====
API_PORT=3001
NODE_ENV=production

# ===== OPTIONAL: Gift Market APIs =====
# GIFTASSET_API_KEY=your_key_here

# ===== OPTIONAL: GetGems NFT API =====
# GETGEMS_API_KEY=your_key_here

# ===== OPTIONAL: Per-user AI keys are stored in DB =====
# Users configure their own AI provider keys via bot /settings or dashboard.
# Supported providers per user: Gemini, Anthropic, Groq, DeepSeek, OpenRouter, Together, OpenAI
