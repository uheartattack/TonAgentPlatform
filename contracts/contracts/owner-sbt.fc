;; ── TAP v3.0 — Owner Identity SBT (soulbound, standalone) ──────────
;; «Паспорт» владельца. Минтится TAP при онбординге, НЕПЕРЕДАВАЕМЫЙ (TEP-85).
;; Хранит непрозрачный tap_user_id (НЕ Telegram id — приватность).
;; Standalone: всё состояние кладётся в state_init при деплое (без init-сообщения).
;; v0 — компилируется; протестировано в sandbox (tests/OwnerSbt.spec.ts).
;;
;; storage#_ index:uint64 collection_address:MsgAddress owner_address:MsgAddress
;;           content:^Cell authority_address:MsgAddress revoked_at:uint64 = Storage;
;; index здесь = непрозрачный tap_user_id. collection_address = addr_none (standalone).

#include "imports/stdlib.fc";
#include "op-codes.fc";

slice addr_none() inline { return begin_cell().store_uint(0, 2).end_cell().begin_parse(); }

(int, slice, slice, cell, slice, int) load_data() inline {
  slice ds = get_data().begin_parse();
  return (
    ds~load_uint(64),     ;; index (tap_user_id)
    ds~load_msg_addr(),   ;; collection_address
    ds~load_msg_addr(),   ;; owner_address
    ds~load_ref(),        ;; content
    ds~load_msg_addr(),   ;; authority_address
    ds~load_uint(64)      ;; revoked_at
  );
}

() store_data(int index, slice collection_address, slice owner_address, cell content, slice authority_address, int revoked_at) impure inline {
  set_data(begin_cell()
    .store_uint(index, 64)
    .store_slice(collection_address)
    .store_slice(owner_address)
    .store_ref(content)
    .store_slice(authority_address)
    .store_uint(revoked_at, 64)
    .end_cell());
}

() send_msg(slice to, int amount, int op, int query_id, builder body, int mode) impure inline {
  var b = begin_cell()
    .store_uint(0x10, 6)            ;; nobounce
    .store_slice(to)
    .store_coins(amount)
    .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
    .store_uint(op, 32)
    .store_uint(query_id, 64);
  if (~ null?(body)) { b = b.store_builder(body); }
  send_raw_message(b.end_cell(), mode);
}

() recv_internal(int my_balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
  slice cs = in_msg_full.begin_parse();
  int flags = cs~load_uint(4);
  if (flags & 1) { return (); } ;; ignore bounced
  slice sender_address = cs~load_msg_addr();

  if (in_msg_body.slice_empty?()) { return (); } ;; topup / empty

  var (index, collection_address, owner_address, content, authority_address, revoked_at) = load_data();

  int op = in_msg_body~load_uint(32);
  int query_id = in_msg_body~load_uint(64);

  ;; ── SOULBOUND: transfer forbidden ──
  if (op == op::transfer()) {
    throw(err::soulbound());
  }

  ;; ── prove_ownership (TEP-85) ──
  if (op == op::prove_ownership()) {
    throw_unless(err::not_owner(), equal_slices(sender_address, owner_address));
    slice dest = in_msg_body~load_msg_addr();
    cell fwd_payload = in_msg_body~load_ref();
    int with_content = in_msg_body~load_uint(1);
    var b = begin_cell()
      .store_uint(index, 256)
      .store_slice(owner_address)
      .store_ref(fwd_payload)
      .store_uint(revoked_at, 64)
      .store_uint(with_content, 1);
    if (with_content == 1) { b = b.store_ref(content); }
    send_msg(dest, 0, op::ownership_proof(), query_id, b, 64);
    return ();
  }

  ;; ── request_owner (TEP-85) ──
  if (op == op::request_owner()) {
    slice dest = in_msg_body~load_msg_addr();
    cell fwd_payload = in_msg_body~load_ref();
    int with_content = in_msg_body~load_uint(1);
    var b = begin_cell()
      .store_uint(index, 256)
      .store_slice(sender_address)
      .store_slice(owner_address)
      .store_ref(fwd_payload)
      .store_uint(revoked_at, 64)
      .store_uint(with_content, 1);
    if (with_content == 1) { b = b.store_ref(content); }
    send_msg(dest, 0, op::owner_info(), query_id, b, 64);
    return ();
  }

  ;; ── destroy: only owner ──
  if (op == op::destroy()) {
    throw_unless(err::not_owner(), equal_slices(sender_address, owner_address));
    store_data(index, collection_address, addr_none(), content, addr_none(), revoked_at);
    send_msg(sender_address, 0, op::excesses(), query_id, null(), 64);
    return ();
  }

  ;; ── revoke: only authority (TAP), e.g. ban ──
  if (op == op::revoke()) {
    throw_unless(err::not_authority(), equal_slices(sender_address, authority_address));
    throw_unless(err::not_inited(), revoked_at == 0);
    store_data(index, collection_address, owner_address, content, authority_address, now());
    return ();
  }

  throw(err::unknown_op());
}

;; ── GET methods ──
(int, int, slice, slice, cell) get_nft_data() method_id {
  var (index, collection_address, owner_address, content, _, _) = load_data();
  return (-1, index, collection_address, owner_address, content);
}

slice get_authority_address() method_id {
  var (_, _, _, _, authority_address, _) = load_data();
  return authority_address;
}

int get_revoked_time() method_id {
  var (_, _, _, _, _, revoked_at) = load_data();
  return revoked_at;
}
