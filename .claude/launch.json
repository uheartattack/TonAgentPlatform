{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "builder-bot",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ts-node", "src/index.ts"],
      "port": 3001
    },
    {
      "name": "landing",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "."],
      "port": 3000
    },
    {
      "name": "infrastructure",
      "runtimeExecutable": "docker-compose",
      "runtimeArgs": ["-f", "infrastructure/docker-compose.yml", "up"],
      "port": 5432
    }
  ]
}
